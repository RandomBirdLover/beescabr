# Python reference implementation (kept local; see CLAUDE.md)
/py

# Local R / editor / macOS junk (generated at the repo root)
.Rhistory
.RData
.RDataTmp
.Rproj.user/
.DS_Store
.claude/

# Everything under data/ stays local: rosters, specimens, cleaned tables,
# analysis outputs, and the API keys in data/secrets/. Nothing here is published.
/data

# Published GitHub Pages site: track ONLY the website files under docs/
docs/*
!docs/*.html
!docs/.nojekyll
!docs/*.jpg
!docs/*.jpeg
!docs/*.webp
!docs/*.png

# Internal working notes (never published)
dev-docs/

# Local-only talk decks (a >100 MB PDF would break the push)
*.pdf

# Local scratch naming convention (used by the pipeline / README)
_to_delete/
_v_*
_fresh_*
_final_*
_check_*
_verify_*
_scratch*
